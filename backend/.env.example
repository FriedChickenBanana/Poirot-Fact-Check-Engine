# ── Poirot Fact-Check Engine — environment variables ──────────────────────
# Copy to `.env` and fill in real values. Never commit your real `.env`.

# Core (required)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require   # Neon DB (PostgreSQL + PGVector)
REDIS_URL=redis://default:password@host:port                          # Upstash Redis (caching + rate limiting)

# Server
PORT=3000

# Optional — embeddings. If unset, RAG falls back to a zero-cost hash-bigram
# vector. Set this for real semantic search (voyage-3, 1024-dim).
VOYAGE_API_KEY=

# Optional — checks existing fact-checks before spending LLM tokens (recommended).
GOOGLE_FACT_CHECK_API_KEY=

# Optional — image feedback storage (used by /feedback for image claims).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
